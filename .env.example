# Copia este archivo como ".env" y rellena lo que uses.
# Los ajustes sin claves (modelo, voz...) estan en ajustes.env

# ---------- Cerebro de IA ----------
# auto      = usa Ollama (gratis, en tu PC) y, si no esta disponible, Claude
# ollama    = solo Ollama
# anthropic = solo Claude (necesita saldo de API en console.anthropic.com)
LLM_PROVEEDOR=auto
# Modelo de Ollama. Vacio = elige solo entre los que tengas descargados.
OLLAMA_MODEL=
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5
# (Opcional) Claude a traves de un proxy compatible (p. ej. OmniRoute). Si esta, solo se envia el token.
# ANTHROPIC_BASE_URL=http://localhost:20128
# ANTHROPIC_AUTH_TOKEN=...

# ---------- Voz (ElevenLabs) ----------
ELEVENLABS_API_KEY=...
# ID de la voz: elevenlabs.io > Voices > pulsa en una voz > "ID"
ELEVENLABS_VOICE_ID=...
# Reconocimiento de tu voz: elevenlabs (por defecto) o local (Whisper, requiere faster-whisper)
STT_MODE=elevenlabs
# Transcribir mientras hablas (mucho mas rapido). 0 = desactivar
STT_VIVO=1
WAKE_WORD=jarvis

# ---------- Interfaz ----------
# web = ventana 3D (usa Chrome, Edge o Brave)   |   clasica = ventana simple
INTERFAZ=web

# (Opcional) Carpeta del segundo cerebro. Vacio = la carpeta cerebro/ junto al programa.
# CEREBRO_DIR=E:\jarvis\cerebro          (Windows)
# CEREBRO_DIR=/Users/tu_usuario/cerebro   (Mac)

# (Opcional) Ollama en otro equipo de tu red (p. ej. el PC con la RTX 4090). Vacio = este equipo.
# OLLAMA_URL=http://192.168.1.50:11434
