# Ajustes de Jarvis SIN claves (las claves van en .env). Lo que pongas en .env tiene prioridad.
# Modelo elegido tras medir en este PC (RTX 4090): qwen3.8:27b -> 68 tok/s, usa bien las herramientas.
OLLAMA_MODEL=qwen3.8:27b
TTS_MODEL=eleven_flash_v2_5
# Con Claude en la nube (OmniRoute), Ollama solo responde si no hay conexion: modelo ligero que carga rapido
OLLAMA_MODEL_RESPALDO=granite4.1:8b

# WhatsApp (los secretos van en .env). Valores por defecto:
# WHATSAPP_PLANTILLA=aviso_jarvis
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_PUERTO=8766
# WHATSAPP_AVISO_MIN=15

# Oido: nivel minimo para considerar que hablas (por defecto 0.01). Bajalo (0.006) si no te oye
# cuando hablas bajo o lejos del microfono; subelo (0.02) si se activa solo con ruidos.
# UMBRAL_VOZ=0.01
# Fijar un microfono por parte de su nombre (si no, usa el predeterminado de Windows):
# MICROFONO=OBSBOT

# Cerebro de respaldo gratuito (OmniRoute), en orden, si Claude falla o se agota. Al añadir proveedores
# gratuitos en OmniRoute (ver LEEME, "Proveedores gratuitos"), auto/best-fast los usa solo.
# MODELOS_GRATIS=antigravity/gemini-3-flash,antigravity/claude-sonnet-4-6,ddgw/gpt-5.6-luna,auto/best-fast

# Tareas de Claude Code: 0 = empiezan al momento, sin pedirte "si" por voz (por WhatsApp siempre lo piden)
# TAREAS_CONFIRMAR=1
